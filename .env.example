# GlobeTrotter Frontend Environment Configuration

# API Endpoints
VITE_API_BASE_URL=/api
VITE_ODOO_API_URL=http://localhost:8069/api/globetrotter

# Map Integration (Provider: 'osm' | 'google' | 'mapbox')
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# AI Travel Recommendation Service (Provider: 'mock' | 'openai' | 'gemini')
VITE_ENABLE_AI=true
VITE_AI_PROVIDER=mock
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
