<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip Tree View -->
    <record id="view_globetrotter_trip_tree" model="ir.ui.view">
        <field name="name">globetrotter.trip.tree</field>
        <field name="model">globetrotter.trip</field>
        <field name="arch" type="xml">
            <tree string="GlobeTrotter Trips" decoration-info="status == 'Upcoming'" decoration-success="status == 'Completed'" decoration-muted="status == 'Cancelled'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="date_range"/>
                <field name="duration_text"/>
                <field name="travel_style"/>
                <field name="budget" widget="monetary"/>
                <field name="estimated_cost" widget="monetary"/>
                <field name="actual_spend" widget="monetary"/>
                <field name="status" widget="badge"/>
                <field name="progress_percentage" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- Trip Form View -->
    <record id="view_globetrotter_trip_form" model="ir.ui.view">
        <field name="name">globetrotter.trip.form</field>
        <field name="model">globetrotter.trip</field>
        <field name="arch" type="xml">
            <form string="GlobeTrotter Trip">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="Draft,Upcoming,Ongoing,Completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Trip Name"/>
                        <h1><field name="name" placeholder="e.g. Goa Adventure"/></h1>
                        <h4><field name="date_range"/> (<field name="duration_text"/>)</h4>
                    </div>
                    <group>
                        <group string="Trip Details">
                            <field name="user_id"/>
                            <field name="code"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="travel_style"/>
                        </group>
                        <group string="Financials &amp; Progress">
                            <field name="currency"/>
                            <field name="budget" widget="monetary"/>
                            <field name="estimated_cost" widget="monetary"/>
                            <field name="actual_spend" widget="monetary"/>
                            <field name="progress_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="A coastal story that begins with Mumbai's harbour..."/>
                        </page>
                        <page string="Stops &amp; Itinerary">
                            <field name="stop_ids">
                                <tree string="Trip Stops">
                                    <field name="sequence" widget="handle"/>
                                    <field name="city"/>
                                    <field name="country"/>
                                    <field name="arrival_date"/>
                                    <field name="departure_date"/>
                                    <field name="color" widget="color"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Expenses">
                            <field name="expense_ids">
                                <tree string="Recorded Expenses">
                                    <field name="date"/>
                                    <field name="category"/>
                                    <field name="description"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="user_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Trip Action -->
    <record id="action_globetrotter_trips" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">globetrotter.trip</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan a new multi-city journey with GlobeTrotter!</p>
        </field>
    </record>
</odoo>
