<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_globetrotter" model="ir.module.category">
            <field name="name">GlobeTrotter Travel</field>
            <field name="description">Manage travel itineraries, destinations, budgets and multi-city trips</field>
            <field name="sequence">25</field>
        </record>

        <!-- Traveler Group -->
        <record id="group_traveler" model="res.groups">
            <field name="name">Traveler</field>
            <field name="category_id" ref="module_category_globetrotter"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can manage own trips, itinerary days, scheduled activities, and logged expenses.</field>
        </record>

        <!-- Admin Group -->
        <record id="group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_globetrotter"/>
            <field name="implied_ids" eval="[(4, ref('group_traveler'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full platform administration: destinations catalog, activities, all trips, analytics, audit logs.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Record Rules: Traveler Own Trip Access -->
        <record id="rule_globetrotter_trip_traveler" model="ir.rule">
            <field name="name">Traveler: Own Trips Only</field>
            <field name="model_id" ref="model_globetrotter_trip"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_traveler'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rules: Admin All Trip Access -->
        <record id="rule_globetrotter_trip_admin" model="ir.rule">
            <field name="name">Admin: All Trips</field>
            <field name="model_id" ref="model_globetrotter_trip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rules: Traveler Own Trip Stops -->
        <record id="rule_globetrotter_stop_traveler" model="ir.rule">
            <field name="name">Traveler: Own Trip Stops</field>
            <field name="model_id" ref="model_globetrotter_trip_stop"/>
            <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_traveler'))]"/>
        </record>

        <record id="rule_globetrotter_stop_admin" model="ir.rule">
            <field name="name">Admin: All Trip Stops</field>
            <field name="model_id" ref="model_globetrotter_trip_stop"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
        </record>

        <!-- Record Rules: Traveler Own Itinerary Days -->
        <record id="rule_globetrotter_day_traveler" model="ir.rule">
            <field name="name">Traveler: Own Itinerary Days</field>
            <field name="model_id" ref="model_globetrotter_itinerary_day"/>
            <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_traveler'))]"/>
        </record>

        <record id="rule_globetrotter_day_admin" model="ir.rule">
            <field name="name">Admin: All Itinerary Days</field>
            <field name="model_id" ref="model_globetrotter_itinerary_day"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
        </record>

        <!-- Record Rules: Traveler Own Activities -->
        <record id="rule_globetrotter_activity_traveler" model="ir.rule">
            <field name="name">Traveler: Own Trip Activities</field>
            <field name="model_id" ref="model_globetrotter_trip_activity"/>
            <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_traveler'))]"/>
        </record>

        <record id="rule_globetrotter_activity_admin" model="ir.rule">
            <field name="name">Admin: All Trip Activities</field>
            <field name="model_id" ref="model_globetrotter_trip_activity"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
        </record>

        <!-- Record Rules: Traveler Own Expenses -->
        <record id="rule_globetrotter_expense_traveler" model="ir.rule">
            <field name="name">Traveler: Own Expenses</field>
            <field name="model_id" ref="model_globetrotter_expense"/>
            <field name="domain_force">[('trip_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_traveler'))]"/>
        </record>

        <record id="rule_globetrotter_expense_admin" model="ir.rule">
            <field name="name">Admin: All Expenses</field>
            <field name="model_id" ref="model_globetrotter_expense"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
        </record>

        <!-- Record Rules: Traveler Own Notifications -->
        <record id="rule_globetrotter_notification_traveler" model="ir.rule">
            <field name="name">Traveler: Own Notifications</field>
            <field name="model_id" ref="model_globetrotter_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_traveler'))]"/>
        </record>
    </data>
</odoo>
